        "id": "read-path",
        "label": "Read path",
        "focus": [
          "health_record",
          "sleep_record",
          "workout",
          "resolver",
          "sqlagg",
          "workoutstats"
        ],
        "note": "Overlap resolution and unit normalisation happen at read time; stored rows stay raw."
      },
      {
        "id": "analysis",
        "label": "Analysis",
        "focus": [
          "resolver",
          "sqlagg",
          "workoutstats",
          "monitor",
          "engines"
        ],
        "note": "Pure functions over value types; today and calendar are always parameters."
      }
    ],

  "cards": [
    {
      "dot": "emerald",
      "title": "One synthetic key, three writers",
      "items": [
        "id = SHA-256 of type, source, device, dates, value, unit",
        "Apple exposes no stable record ID; INSERT OR IGNORE closes it",
        "Re-importing 1.79M records inserts 0 rows"
      ]
    },
    {
      "dot": "cyan",
      "title": "Reading is where the rules live",
      "items": [
        "Overlaps are resolved at read time; stored rows stay raw",
        "Sweep line — the old linear scan was O(n²) on 28k samples",
        "Sources match by substring: \"Apple Watch de Vincent\""
      ]
    },
    {
      "dot": "amber",
      "title": "Boundaries that bite",
      "items": [
        "Half-open ranges: midnight is never counted twice",
        "388k heart-rate rows are aggregated in SQL, not in memory",
        "distanceKilometres: the export mixes km and metres"
      ]
    }
  ]

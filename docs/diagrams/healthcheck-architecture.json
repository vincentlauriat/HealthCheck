  "cards": [
    {
      "dot": "cyan",
      "title": "Why three ingestion paths",
      "items": [
        "macOS has no HealthKit — isHealthDataAvailable() is false",
        "Zip export is primary; the iPhone pushes deltas over the LAN",
        "Withings holds muscle mass, hydration and bone mass"
      ]
    },
    {
      "dot": "emerald",
      "title": "Idempotent by construction",
      "items": [
        "Primary key = SHA-256 of type, source, device, dates, value",
        "INSERT OR IGNORE, 5000 rows per transaction",
        "Re-importing 1.79M records inserts 0"
      ]
    },
    {
      "dot": "rose",
      "title": "Local by design, shared by construction",
      "items": [
        "Withings and the Sparkle appcast are the only outbound calls",
        "Tokens in Application Support, chmod 600",
        "HealthCheckShared compiles into both targets"
      ]
    }
  ]
